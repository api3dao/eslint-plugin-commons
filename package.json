{
  "name": "@api3/eslint-plugin-commons",
  "version": "3.1.1",
  "description": "ESLint configurations used across API3 projects.",
  "license": "MIT",
  "repository": "github:api3dao/eslint-plugin-commons",
  "exports": "./index.js",
  "sideEffects": false,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@11.27.1",
  "scripts": {
    "eslint:check": "eslint --report-unused-disable-directives --cache . --max-warnings 0",
    "eslint:fix": "pnpm run eslint:check --fix",
    "prepare": "husky",
    "prettier:check": "prettier --check \"./**/*.{js,ts,md,json}\"",
    "prettier:fix": "prettier --write \"./**/*.{js,ts,md,json}\"",
    "test": "node scripts/check-configs.js",
    "release:tag": "node scripts/tag-and-release.js"
  },
  "files": [
    "index.js",
    "src/"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin"
  ],
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-package-json": "^1.0.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lodash": "^8.1.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0"
  },
  "devDependencies": {
    "@api3/commons": "^0.13.4",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  }
}
